# Formatting rules shared by every editor that opens this repository.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{cs,csproj,props}]
indent_size = 4

[*.{ts,tsx,js,json,yml,yaml,md}]
indent_size = 2
