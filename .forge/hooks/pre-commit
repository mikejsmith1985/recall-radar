#!/usr/bin/env bash
# Forge Workflow Pre-Commit Hook (Enhanced)
# Generated by Forge Terminal Workflow Architect
# Enforces: main branch block, test file gate, CHANGELOG, naming, branch naming.
# Bypass with: git commit --no-verify (bypasses are logged)

set +e
violations=()
warnings=()

# ── MAIN BRANCH BLOCK (Gate 2) ──────────────────────────────────────────
# Commits directly to main are forbidden. All work must happen on feature branches.
current_branch=$(git branch --show-current 2>/dev/null)
if [[ "$current_branch" == "main" || "$current_branch" == "master" ]]; then
    violations+=("MAIN BRANCH: Cannot commit directly to main — create a feature branch first")
fi

# Branch Naming Check
if [[ -n "$current_branch" ]] && ! echo "$current_branch" | grep -qE "^(main|master|develop|feature/.+|fix/.+|chore/.+|docs/.+|hotfix/.+|release/.+)$"; then
    violations+=("BRANCH: '$current_branch' does not match naming convention")
fi

# Get Staged Files
staged_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)
[[ -z "$staged_files" ]] && exit 0

# Filter to source files
source_files=$(echo "$staged_files" | grep -E '\.(go|js|jsx|ts|tsx|py|rs|java|cs)$')

# ── TEST FILE GATE (Gate 4) ─────────────────────────────────────────────
# Every new source file must have a corresponding test file staged or on disk.
# Build output directories are excluded — they contain compiled artifacts, not
# authored source code, and must never be flagged for missing test coverage.
# Package markers (__init__.py), test fixtures (conftest.py), and everything
# under tests/ are excluded for the same reason: they hold no authored logic
# a test could exercise. Migration directories hold generated output that is
# executed and verified end to end by the migration tests rather than imported.
# Served static assets are excluded on the same grounds: nothing imports them,
# and the browser suite loads them from a real server and asserts on what they
# do. Naming an app.test.js beside one would create a file no runner executes,
# which is weaker coverage than the browser check, not stronger.
# The gate keeps full force over real modules.
new_source_files=$(git diff --cached --name-only --diff-filter=A 2>/dev/null | grep -E '\.(go|js|jsx|ts|tsx|py|rs|java|cs)$' | grep -vE '^(cmd/forge/web/|frontend/dist/|bin/)' | grep -vE '(^|/)(__init__|conftest)\.py$' | grep -vE '^tests/' | grep -vE '/[Mm]igrations/' | grep -vE '/web/static/')
if [[ -n "$new_source_files" ]]; then
    while IFS= read -r new_file; do
        [[ -z "$new_file" ]] && continue
        base=$(basename "$new_file")
        # Skip files that are themselves test files (every supported convention).
        if echo "$base" | grep -qE '(_test\.go|\.test\.(js|jsx|ts|tsx)|\.spec\.(js|jsx|ts|tsx)|_test\.py|_test\.rs|Tests?\.cs|(Test|Tests|IT)\.java)$'; then continue; fi
        if echo "$base" | grep -qE '^test_.*\.py$'; then continue; fi
        extension="${new_file##*.}"
        leaf="${base%.*}"
        has_test=false
        # Candidate test FILE NAMES for this source leaf, by language.
        candidates=""
        case "$extension" in
            go)   candidates="${leaf}_test.go" ;;
            js)   candidates="${leaf}.test.js ${leaf}.spec.js" ;;
            jsx)  candidates="${leaf}.test.jsx ${leaf}.spec.jsx" ;;
            ts)   candidates="${leaf}.test.ts ${leaf}.spec.ts" ;;
            tsx)  candidates="${leaf}.test.tsx ${leaf}.spec.tsx" ;;
            py)   candidates="test_${leaf}.py ${leaf}_test.py" ;;
            rs)   candidates="${leaf}_test.rs" ;;
            cs)   candidates="${leaf}Tests.cs ${leaf}Test.cs ${leaf}.Tests.cs ${leaf}.Test.cs" ;;
            java) candidates="${leaf}Test.java ${leaf}Tests.java ${leaf}IT.java" ;;
        esac
        # Rust frequently keeps unit tests inline via #[cfg(test)].
        if [[ "$extension" == "rs" && -f "$new_file" ]] && grep -q '#\[cfg(test)\]' "$new_file"; then has_test=true; fi
        if [[ "$has_test" == "false" ]]; then
            for cand in $candidates; do
                # A test file staged or already present anywhere in the repo satisfies the gate.
                if [[ -n "$(find . -type f -name "$cand" 2>/dev/null | head -n1)" ]]; then has_test=true; break; fi
            done
        fi
        # Naming a test file after the behaviour it checks rather than after the
        # module is good practice, so a filename match is not the only evidence a
        # module is tested. Accept a test that imports the module by name. An
        # untested module still has neither, so the gate keeps its teeth.
        if [[ "$has_test" == "false" && -d tests ]]; then
            module_path="${new_file#src/}"; module_path="${module_path%.*}"
            dotted="${module_path//\//.}"
            parent="${dotted%.*}"; leaf="${dotted##*.}"
            # Both import forms count. Linters rewrite between them, so matching
            # only one makes the gate fire on formatting rather than on coverage.
            if grep -rqE "(import|from)[[:space:]]+.*${dotted}" tests 2>/dev/null                || grep -rqE "from[[:space:]]+${parent}[[:space:]]+import[[:space:]]+.*${leaf}" tests 2>/dev/null; then
                has_test=true
            fi
        fi
        if [[ "$has_test" == "false" ]]; then
            violations+=("TEST FILE: New source file '$new_file' has no corresponding test file")
        fi
    done <<< "$new_source_files"
fi

# ── CHANGELOG CHECK (Gate 7 — upgraded to violation) ────────────────────
# Source files changed but CHANGELOG.md not updated = blocking violation.
has_source_changes=false
[[ -n "$source_files" ]] && has_source_changes=true
changelog_updated=$(echo "$staged_files" | grep -c "CHANGELOG\.md$")
if $has_source_changes && [[ "$changelog_updated" -eq 0 ]]; then
    violations+=("CHANGELOG: Source files changed but CHANGELOG.md was not updated")
fi

# Report Results
if [[ ${#violations[@]} -gt 0 ]]; then
    echo -e "\n\033[31mPRE-COMMIT VIOLATIONS (blocking):\033[0m"
    for v in "${violations[@]}"; do echo -e "  \033[31m* $v\033[0m"; done
fi
if [[ ${#warnings[@]} -gt 0 ]]; then
    echo -e "\n\033[33mPRE-COMMIT WARNINGS (non-blocking):\033[0m"
    for w in "${warnings[@]}"; do echo -e "  \033[33m* $w\033[0m"; done
fi
if [[ ${#violations[@]} -eq 0 ]] && [[ ${#warnings[@]} -eq 0 ]]; then
    echo -e "\033[32mPre-commit checks passed\033[0m"
fi

if [[ ${#violations[@]} -gt 0 ]]; then
    echo -e "\033[31mCommit blocked. Fix violations or use --no-verify to bypass.\033[0m"
    exit 1
fi
exit 0
