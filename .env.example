# Copy to .env (gitignored) and fill in. Never commit .env.
# Password for the local docker-compose Postgres. Pick anything; it only guards a container on your machine.
RECALLRADAR_DB_PASSWORD=
# Connection string the API, the ingest CLI and dotnet-ef use. Must match the password above.
RECALLRADAR_CONNECTION=Host=127.0.0.1;Port=5433;Database=recallradar;Username=recallradar;Password=${RECALLRADAR_DB_PASSWORD}
# API keys are injected by the Forge Vault; leave them out of this file.
